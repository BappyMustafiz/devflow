generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  issues    Issue[]
}

model Issue {
  id          Int         @id @default(autoincrement())
  title       String
  description String? // 👈 add this
  status      IssueStatus @default(open)
  assignee    User?       @relation(fields: [assigneeId], references: [id])
  assigneeId  Int?
  project     Project?    @relation(fields: [projectId], references: [id])
  projectId   Int?
  createdAt   DateTime    @default(now())
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  issues      Issue[] // 👈 just this, no @relation needed
  createdAt   DateTime @default(now())
}

enum IssueStatus {
  open
  in_progress
  closed
}
